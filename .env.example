# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the browser. Used for the
# fingerprint/onboarding storage flow. Keep this out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — server-only, used from API routes for Review,
# fingerprint analysis, and the highlight-to-ask advice mode.
ANTHROPIC_API_KEY=

# Public URL of the deployed site (used for OAuth redirects). For local dev
# this is http://localhost:3000; set it to the real Netlify URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
